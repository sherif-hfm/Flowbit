    {
      "id": 2,
      "name": "Normalise Order Lines",
      "externalId": "SCRIPT_NORMALISE_ORDER_LINES",
      "type": "scriptTask",
      "laneId": 1,
      "x": 240,
      "y": 76,
      "roles": [],
      "variables": [],
      "scriptFormat": "javascript",
      "script": "var lines = execution.getVariable('orderLines');\nif (!Array.isArray(lines) || lines.length === 0) {\n  throw new Error('The order has no lines.');\n}\nvar normalised = lines.map(function (line, index) {\n  var sku = line && typeof line.sku === 'string' ? line.sku.trim().toUpperCase() : '';\n  var quantity = line ? line.quantity : null;\n  if (sku.length === 0 || typeof quantity !== 'number' || quantity <= 0 || Math.floor(quantity) !== quantity) {\n    throw new Error('Order line ' + (index + 1) + ' needs a SKU and a whole positive quantity.');\n  }\n  return { sku: sku, quantity: quantity };\n});\nexecution.setVariable('stockLines', normalised);\nexecution.setVariable('shippingService', execution.getVariable('expedited') ? 'express' : 'standard');",
      "usesFlowInfo": false
    },
    {
      "id": 3,
      "name": "Invalid Order Lines",
      "externalId": "BOUNDARY_INVALID_ORDER_LINES",
