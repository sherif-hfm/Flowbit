      "type": "messageStartEvent",
      "laneId": 1,
      "x": 80,
      "y": 88,
      "roles": [],
      "variables": [],
      "message": {
        "clientId": "${setting.examples.messageClientId}",
        "clientSecret": "${config.exampleMessageClientSecret}",
        "headerName": "X-Flowbit-Correlation",
        "headerValue": "${setting.examples.messageCorrelation}",
        "outputMappings": [
          {
            "variable": "orderId",
            "path": "order.id",
            "dataType": "string",
            "isArray": false,
            "required": true,
            "defaultValue": null,
            "validation": "StartsWith(orderId, 'ORD-') and Len(orderId) <= 40"
          },
          {
            "variable": "customerId",
            "path": "customer.id",
            "dataType": "string",
            "isArray": false,
            "required": true,
            "defaultValue": null,
            "validation": "IsMatch(customerId, '^[A-Za-z0-9-]{3,40}$')"
          },
          {
            "variable": "orderTotal",
            "path": "order.total",
            "dataType": "number",
            "isArray": false,
            "required": true,
            "defaultValue": null,
            "validation": "orderTotal > 0"
          },
          {
            "variable": "orderLines",
            "path": "order.lines",
