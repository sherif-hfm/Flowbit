    {
      "id": 2,
      "name": "Price Each Order Line",
      "externalId": "SCRIPT_PRICE_EACH_ORDER_LINE",
      "type": "scriptTask",
      "laneId": null,
      "x": 220,
      "y": 128,
      "roles": [],
      "variables": [],
      "asyncBefore": true,
      "asyncAfter": false,
      "multiInstance": {
        "mode": "parallel",
        "source": "collection",
        "collectionVariable": "orderLines",
        "completionEvaluation": "afterAll",
        "maxConcurrency": 3,
        "outputVariables": [
          {
            "name": "lineAmount",
            "dataType": "number",
            "isArray": false,
            "nullable": false
          },
          {
            "name": "lineSummary",
            "dataType": "json",
            "isArray": false,
            "nullable": false
          }
        ],
        "resultVariable": "lineResults"
      },
      "scriptFormat": "javascript",
      "assignments": [],
      "script": "const item = execution.getVariable('mi.item');\nconst index = execution.getVariable('mi.index');\nconst total = execution.getVariable('mi.total');\nconst multiplier = execution.getVariable('multiplier');\nif (typeof item.quantity !== 'number' || typeof item.unitPrice !== 'number') {\n  throw new Error('Order line ' + (index + 1) + ' needs a numeric quantity and unitPrice.');\n}\nconst amount = item.quantity * item.unitPrice * multiplier;\nexecution.setVariable('lineAmount', amount);\nexecution.setVariable('lineSummary', { line: index + 1, lineCount: total, sku: item.sku, amount: amount });",
      "usesFlowInfo": false
    },
    {
      "id": 3,
      "name": "Order Lines Priced",
      "externalId": "END_ORDER_LINES_PRICED",
      "type": "endEvent",
      "laneId": null,
      "x": 520,
      "y": 140,
      "roles": [],
      "variables": []
    }
  ],
