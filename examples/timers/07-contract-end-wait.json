          "nullable": false,
          "required": true,
          "defaultValue": null,
          "validation": "IsMatch(contractEnd, '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2}([.,][0-9]{1,7})?)?(Z|[+-][0-9]{2}:[0-9]{2})$')",
          "label": "Contract end",
          "helpText": "Date and time with Z or an explicit offset, such as 2026-12-31T17:00:00+01:00."
        }
      ]
    },
    {
      "id": 2,
      "name": "Wait Until Contract End",
