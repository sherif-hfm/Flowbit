      "name": "policyVersion",
      "dataType": "number",
      "isArray": false,
      "required": false,
      "nullable": true,
      "defaultValue": null,
      "validation": "policyVersion > 0"
    },
    {
      "id": 2,
      "name": "effectiveDate",
      "dataType": "date",
      "isArray": false,
      "required": false,
      "nullable": true,
