        "outputMappings": [
          {
            "variable": "policyVersion",
            "path": "version",
            "required": true,
            "dataType": "number",
            "isArray": false
          },
          {
            "variable": "effectiveDate",
            "path": "effectiveDate",
            "required": false,
            "dataType": "date",
            "isArray": false
          }
        ]
      }
    },
    {
