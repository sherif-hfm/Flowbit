# Optional local Compose overrides. Copy to .env before starting the stack.
# These are public development values, not production credentials.
# compose.yaml explicitly uses Authentication:Mode=DevelopmentToken.
# For built-in username/password login, enable the Local override below.
# For provider sign-in use compose.oidc.yaml and docs/openid-connect.md with host HTTPS API/UI.
# Use simple database/user names (letters, digits, underscores).
POSTGRES_DB=flowbit
POSTGRES_USER=flowbit
# Single-quote a custom password containing $ to prevent Compose interpolation.
POSTGRES_PASSWORD=flowbit-local-only
POSTGRES_PORT=55439
FLOWBIT_API_PORT=15017
FLOWBIT_UI_PORT=15152
FLOWBIT_WORKER_PORT=18081
FLOWBIT_JWT_ISSUER=flowbit-local
FLOWBIT_JWT_AUDIENCE=flowbit-api
# HMAC-SHA256 requires a key of at least 32 bytes.
FLOWBIT_JWT_KEY=flowbit-local-development-signing-key-change-me-2026
# Lifecycle webhooks: a folder holding webhook-keys.pfx, the certificate that wraps the
# shared webhook key ring, and its password. See docs/deployment.md#lifecycle-webhooks.
FLOWBIT_WEBHOOK_CERT_DIR=./dev/webhooks
FLOWBIT_WEBHOOK_CERT_PASSWORD=flowbit-local-webhooks
# The Worker sends webhook requests only when this is true.
FLOWBIT_WEBHOOK_DELIVERY_ENABLED=false

# Optional built-in account login: uncomment and configure these together.
# See docs/local-authentication.md#docker-compose-with-password-login for HTTPS setup.
# The comma separator works in PowerShell and Bash.
# COMPOSE_PATH_SEPARATOR=,
# COMPOSE_FILE=compose.yaml,compose.local.yaml
# For HTTP on all host IPv4 addresses, use this COMPOSE_FILE value instead.
# COMPOSE_FILE=compose.yaml,compose.local-http.yaml
# FLOWBIT_LOCAL_SIGNING_KEY='<your-random-secret-at-least-32-bytes>'
# FLOWBIT_LOCAL_BOOTSTRAP_USERNAME=admin
# FLOWBIT_LOCAL_BOOTSTRAP_PASSWORD='<your-initial-password>'
# The certificate settings are only used with compose.local.yaml (HTTPS).
# FLOWBIT_HTTPS_CERT_PASSWORD='<your-exported-certificate-password>'
# FLOWBIT_HTTPS_CERT_DIR=./dev/https
# FLOWBIT_UI_HTTPS_PORT=15153
