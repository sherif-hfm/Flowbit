# Optional local Compose overrides. Copy to .env before starting the stack.
# These are public development values, not production credentials.
# Use simple database/user names (letters, digits, underscores).
POSTGRES_DB=flowbit
POSTGRES_USER=flowbit
# Single-quote a custom password containing $ to prevent Compose interpolation.
POSTGRES_PASSWORD=flowbit-local-only
POSTGRES_PORT=55439
FLOWBIT_API_PORT=15017
FLOWBIT_UI_PORT=15152
FLOWBIT_WORKER_PORT=18081
FLOWBIT_JWT_ISSUER=flowbit-local
FLOWBIT_JWT_AUDIENCE=flowbit-api
# HMAC-SHA256 requires a key of at least 32 bytes.
FLOWBIT_JWT_KEY=flowbit-local-development-signing-key-change-me-2026
