{
  "realm": "flowbit",
  "enabled": true,
  "displayName": "Flowbit local development",
  "sslRequired": "none",
  "registrationAllowed": false,
  "editUsernameAllowed": false,
  "resetPasswordAllowed": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "roles": {
    "realm": [
      { "name": "admin" },
      { "name": "Requester" },
      { "name": "Reviewer" },
      { "name": "Supervisor" },
      { "name": "Finance" },
      { "name": "Manager" },
      { "name": "RoleManager" },
      { "name": "WorkflowAdministrator" },
      { "name": "offline_access" }
    ]
  },
  "clientScopes": [
    {
      "name": "profile",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" },
      "protocolMappers": []
    },
    {
      "name": "offline_access",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" },
      "protocolMappers": []
    },
    {
      "name": "flowbit.api",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "flowbit-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "flowbit-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "flowbit-actor",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "username",
            "claim.name": "flowbit_user",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "flowbit-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "flowbit-ui",
      "name": "Flowbit.Ui code with PKCE",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "flowbit-ui-local-only",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": ["https://localhost:7019/signin-oidc"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://localhost:7019/signout-callback-oidc"
      },
      "defaultClientScopes": ["profile"],
      "optionalClientScopes": ["offline_access", "flowbit.api"]
    },
    {
      "clientId": "flowbit-ui-no-pkce",
      "name": "Flowbit.Ui explicit legacy code compatibility",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "flowbit-ui-legacy-local-only",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": ["https://localhost:7019/signin-oidc"],
      "webOrigins": [],
      "attributes": {
        "post.logout.redirect.uris": "https://localhost:7019/signout-callback-oidc"
      },
      "defaultClientScopes": ["profile"],
      "optionalClientScopes": ["offline_access", "flowbit.api"]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Flowbit",
      "email": "alice@example.test",
      "credentials": [{ "type": "password", "value": "111", "temporary": false }],
      "realmRoles": ["admin", "Requester", "Reviewer", "WorkflowAdministrator", "offline_access"]
    },
    {
      "username": "bob",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Flowbit",
      "email": "bob@example.test",
      "credentials": [{ "type": "password", "value": "111", "temporary": false }],
      "realmRoles": ["Reviewer", "offline_access"]
    },
    {
      "username": "carol",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Carol",
      "lastName": "Flowbit",
      "email": "carol@example.test",
      "credentials": [{ "type": "password", "value": "111", "temporary": false }],
      "realmRoles": ["Requester", "offline_access"]
    },
    {
      "username": "supervisor",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Supervisor",
      "lastName": "Flowbit",
      "email": "supervisor@example.test",
      "credentials": [{ "type": "password", "value": "111", "temporary": false }],
      "realmRoles": ["Reviewer", "Supervisor", "offline_access"]
    },
    {
      "username": "finance",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Finance",
      "lastName": "Flowbit",
      "email": "finance@example.test",
      "credentials": [{ "type": "password", "value": "111", "temporary": false }],
      "realmRoles": ["Finance", "offline_access"]
    },
    {
      "username": "manager",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Manager",
      "lastName": "Flowbit",
      "email": "manager@example.test",
      "credentials": [{ "type": "password", "value": "111", "temporary": false }],
      "realmRoles": ["Manager", "RoleManager", "offline_access"]
    }
  ]
}
