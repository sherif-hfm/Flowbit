{
  "Authentication": {
    "Mode": "OpenIdConnect",
    "Oidc": {
      "Authority": "http://localhost:18080/realms/flowbit",
      "Audience": "flowbit-api",
      "NameClaimType": "flowbit_user",
      "RoleClaimType": "roles",
      "ScopeClaimType": "scope",
      "RequiredScope": "flowbit.api",
      "AllowHttpMetadata": true
    }
  },
  "Jwt": {
    "Issuer": "workflow-engine-dev",
    "Audience": "workflow-engine-api",
    "Key": "dev-only-symmetric-signing-key-change-me-please-32+"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    }
  }
}
