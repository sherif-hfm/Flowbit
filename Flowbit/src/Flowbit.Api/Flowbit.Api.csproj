<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Flowbit.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Flowbit.Service\Flowbit.Service.csproj" />
    <ProjectReference Include="..\Flowbit.Infrastructure\Flowbit.Infrastructure.csproj" />
    <ProjectReference Include="..\Flowbit.Shared\Flowbit.Shared.csproj" />
    <ProjectReference Include="..\..\tools\AuthoringExport\AuthoringExport.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <AuthoringPackageOutput>$(MSBuildProjectDirectory)/obj/$(Configuration)/$(TargetFramework)/authoring</AuthoringPackageOutput>
  </PropertyGroup>
  <Target Name="ExportFlowbitAuthoringPackage" BeforeTargets="GetCopyToOutputDirectoryItems;ComputeFilesToPublish" DependsOnTargets="ResolveProjectReferences" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="dotnet &quot;$(MSBuildProjectDirectory)/../../tools/AuthoringExport/bin/$(Configuration)/$(TargetFramework)/Flowbit.AuthoringExport.dll&quot; &quot;$(MSBuildProjectDirectory)/../../..&quot; &quot;$(AuthoringPackageOutput)&quot;" />
    <ItemGroup>
      <_FlowbitAuthoringResource Include="$(AuthoringPackageOutput)/**/*" />
      <_FlowbitAuthoringResource>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <TargetPath>authoring/%(_FlowbitAuthoringResource.RecursiveDir)%(_FlowbitAuthoringResource.Filename)%(_FlowbitAuthoringResource.Extension)</TargetPath>
      </_FlowbitAuthoringResource>
      <ContentWithTargetPath Include="@(_FlowbitAuthoringResource)" />
    </ItemGroup>
  </Target>

</Project>
