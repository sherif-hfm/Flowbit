{
  "WorkflowAi": {
    "Enabled": true,
    "OpenCodeModels": [ "kimi-k2.7-code", "glm-5.3", "glm-5.3-flash" ],
    "MaxInputCharacters": 200000,
    "MaxContextCharacters": 750000,
    "MaxWorkflowCharacters": 2097152,
    "MaxOutputBytes": 2097152,
    "MaxHistoryMessages": 30,
    "MaxRepairAttempts": 2,
    "RequestTimeoutSeconds": 180,
    "MaxConcurrentRequests": 4
  },
  "WorkflowAiDocuments": {
    "MaxBytes": 20971520,
    "MaxPages": 100,
    "MaxCharacters": 200000,
    "TimeoutSeconds": 300,
    "ProcessTimeoutSeconds": 45,
    "MaxRasterDimension": 4096,
    "MaxConcurrentExtractions": 2,
    "PdfToPpmPath": "pdftoppm",
    "TesseractPath": "tesseract"
  },
  "WorkflowMessageDelivery": {
    "MaxPayloadBytes": 1048576
  },
  "WorkflowDurableProcessing": {
    "PublicationEnabled": true
  },
  "ConnectionStrings": {
    "Flowbit": "Host=localhost;Port=5432;Database=workflow_engine;Username=postgres;Password=P@ssw0rd"
  },
  "WorkflowContext": {
    "AllowedClaims": [ "depId" ]
  },
  "WorkflowAudit": {
    "AllowedClaims": []
  },
  "Jwt": {
    "Issuer": "workflow-engine-dev",
    "Audience": "workflow-engine-api",
    "Key": "dev-only-symmetric-signing-key-change-me-please-32+"
  },
  "WorkflowServiceTasks": {
    "MaxTimeoutSeconds": 300,
    "MaxResponseBodyBytes": 1048576
  },
  "WorkflowScript": {
    "TimeoutSeconds": 5,
    "MaxStatements": 100000,
    "MemoryBytes": 8000000,
    "MaxRecursionDepth": 128,
    "MaxExecutionStackCount": 256,
    "RegexTimeoutMilliseconds": 1000,
    "MaxArraySize": 10000,
    "MaxValueDepth": 32,
    "MaxValueItems": 10000,
    "MaxValueBytes": 1048576
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/flowbit-api-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
