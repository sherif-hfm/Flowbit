{
  "WorkflowAi": {
    "Enabled": true,
    "OpenCodeBaseUrl": "https://opencode.ai/zen/v1/",
    "OpenCodeModels": [ "glm-5.3-flash" ],
    "OpenCodeReasoningEfforts": { "glm-5.3-flash": "high" },
    "MaxInputCharacters": 200000,
    "MaxWorkflowCharacters": 2097152,
    "RunTimeoutSeconds": 1800,
    "MaxProviderCalls": 40,
    "MaxModelOutputTokens": 32768,
    "MaxNudges": 2,
    "MaxConcurrentRequests": 4
  },
  "WorkflowAiDocuments": {
    "MaxBytes": 20971520,
    "MaxPages": 100,
    "MaxCharacters": 200000,
    "TimeoutSeconds": 300,
    "ProcessTimeoutSeconds": 45,
    "MaxRasterDimension": 4096,
    "MaxConcurrentExtractions": 2,
    "PdfToPpmPath": "pdftoppm",
    "TesseractPath": "tesseract"
  },
  "WorkflowMessageDelivery": {
    "MaxPayloadBytes": 1048576
  },
  "WorkflowDurableProcessing": {
    "PublicationEnabled": true
  },
  "ConnectionStrings": {
    "Flowbit": "Host=localhost;Port=5432;Database=workflow_engine;Username=postgres;Password=P@ssw0rd"
  },
  "WorkflowContext": {
    "AllowedClaims": [ "depId" ]
  },
  "WorkflowAudit": {
    "AllowedClaims": []
  },
  "Authentication": {
    "Mode": "OpenIdConnect",
    "Oidc": {
      "Authority": "",
      "Audience": "flowbit-api",
      "NameClaimType": "flowbit_user",
      "RoleClaimType": "roles",
      "ScopeClaimType": "scope",
      "RequiredScope": "flowbit.api",
      "AllowHttpMetadata": false
    }
  },
  "WorkflowServiceTasks": {
    "MaxTimeoutSeconds": 300,
    "MaxResponseBodyBytes": 1048576
  },
  "WorkflowScript": {
    "TimeoutSeconds": 5,
    "MaxStatements": 100000,
    "MemoryBytes": 8000000,
    "MaxRecursionDepth": 128,
    "MaxExecutionStackCount": 256,
    "RegexTimeoutMilliseconds": 1000,
    "MaxArraySize": 10000,
    "MaxValueDepth": 32,
    "MaxValueItems": 10000,
    "MaxValueBytes": 1048576
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/flowbit-api-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
