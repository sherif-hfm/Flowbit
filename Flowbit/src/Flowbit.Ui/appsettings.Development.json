{
  "WorkflowApi": {
    "BaseUrl": "https://localhost:7291"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "Jwt": {
    "Issuer": "workflow-engine-dev",
    "Audience": "workflow-engine-api",
    "Key": "dev-only-symmetric-signing-key-change-me-please-32+"
  },
  "Authentication1": {
    "Mode": "OpenIdConnect",
    "Oidc": {
      "Authority": "http://localhost:18080/realms/flowbit",
      "ClientId": "flowbit-ui",
      "ClientSecret": "flowbit-ui-local-only",
      "UsePkce": true,
      "AllowHttpMetadata": true,
      "Scopes": [ "openid", "profile", "email", "offline_access", "flowbit.api" ]
    }
  },
  "Authentication": {
    "Mode": "Local",
    "Session": {
      "AbsoluteLifetime": "08:00:00",
      "RevalidationInterval": "00:01:00"
    },
    "DataProtectionKeysPath": "D:\\Flowbit\\keys"
  }
}
