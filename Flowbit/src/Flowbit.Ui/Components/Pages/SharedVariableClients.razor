@page "/shared-variable-clients"
@implements IDisposable
@using System.Globalization
@using System.Net
@using Flowbit.Ui.Auth
@inject WorkflowApiClient Api
@inject TokenState Token
@inject IJSRuntime JS

<PageTitle>Shared Variable API Clients · Flowbit</PageTitle>

<PageHeader Eyebrow="Manage" Title="Shared-variable API clients"
            Description="Issue machine credentials for the shared-variable API. Secrets are generated by Flowbit, stored only as proofs, and shown once.">
    <Actions>
        <a class="btn btn-outline-primary" href="shared-variables"><AppIcon Name="settings" /> Shared variables</a>
        <button class="btn btn-outline-primary" @onclick="OpenCreate" disabled="@(!Token.HasToken || busy)"><AppIcon Name="plus" /> Add client</button>
        <button class="btn btn-primary" @onclick="LoadAsync" disabled="@(!Token.HasToken || busy)"><AppIcon Name="refresh" /> Refresh</button>
    </Actions>
</PageHeader>

@if (!string.IsNullOrWhiteSpace(error)) { <div class="alert alert-danger" role="alert">@error</div> }
@if (!string.IsNullOrWhiteSpace(success)) { <div class="alert alert-success" role="status">@success</div> }

@if (!Token.HasToken)
{
    <section class="panel"><EmptyState Icon="token" Title="An administrative identity is required" Description="Client administration accepts the configured JWT administrator role only."><a class="btn btn-primary" href="token">Set test identity</a></EmptyState></section>
}
else
{
    @if (!string.IsNullOrWhiteSpace(oneTimeSecret) && secretClient is not null)
    {
        <section class="panel mb-3 border-warning" aria-labelledby="shared-variable-secret-heading">
            <div class="section-heading">
                <div><h2 id="shared-variable-secret-heading">Save this client secret now</h2><p>It will not be available after this panel closes or the page reloads.</p></div>
                <button type="button" class="btn-close" aria-label="Hide one-time secret" @onclick="ClearSecret"></button>
            </div>
            <div class="alert alert-warning">Do not paste this secret into workflow JSON or the shared-variable management page. Store it in the calling service's secret manager.</div>
            <div class="form-grid">
                <div><span class="form-label d-block">Client ID</span><code class="d-block text-break">@secretClient.ClientId</code></div>
                <div class="full"><span class="form-label d-block">Client secret</span><code class="d-block text-break">@oneTimeSecret</code></div>
            </div>
            <div class="d-flex flex-wrap gap-2 mt-3">
                <button class="btn btn-primary" @onclick="CopyCredentialsAsync">Copy header template</button>
                <button class="btn btn-outline-secondary" @onclick="ClearSecret">I saved it</button>
            </div>
            <pre class="mt-3 mb-0"><code>X-Client-Id: @secretClient.ClientId
X-Client-Secret: @oneTimeSecret</code></pre>
        </section>
    }

    @if (formOpen)
    {
        <section class="panel mb-3" aria-labelledby="shared-variable-client-form-heading">
            <div class="section-heading"><div><h2 id="shared-variable-client-form-heading">@(editingClient is null ? "Add API client" : $"Edit {editingClient.ClientId}")</h2><p>The client ID is case-sensitive and immutable. Scope or expiration changes use optimistic concurrency.</p></div><button type="button" class="btn-close" aria-label="Close client form" @onclick="CloseForm"></button></div>
            @if (!string.IsNullOrWhiteSpace(formError))
            {
                <div class="alert alert-danger" role="alert">@formError@if (clientConflict && editingClient is not null) { <button class="btn btn-sm btn-outline-danger ms-2" @onclick="ReloadClientEditAsync" disabled="@busy">Load current revision</button> }</div>
            }
            <div class="form-grid">
                <div><label class="form-label" for="shared-client-id">Client ID</label><input id="shared-client-id" class="form-control" maxlength="300" autocomplete="off" placeholder="erp-production" readonly="@(editingClient is not null)" @bind="formClientId" @bind:event="oninput" /></div>
                <div><label class="form-label" for="shared-client-name">Display name</label><input id="shared-client-name" class="form-control" maxlength="300" autocomplete="off" placeholder="ERP production integration" @bind="formDisplayName" @bind:event="oninput" /></div>
                <div class="full">
                    <span class="form-label d-block">Scopes</span>
                    <div class="d-flex flex-wrap gap-4">
                        <div class="form-check"><input id="shared-client-read" class="form-check-input" type="checkbox" @bind="formRead" /><label class="form-check-label" for="shared-client-read">Read shared variables</label></div>
                        <div class="form-check"><input id="shared-client-write" class="form-check-input" type="checkbox" @bind="formWrite" /><label class="form-check-label" for="shared-client-write">Create and update shared variables</label></div>
                    </div>
                </div>
                <div><label class="form-label" for="shared-client-expires">Expires (optional, local time)</label><input id="shared-client-expires" class="form-control" type="datetime-local" @bind="formExpires" /></div>
            </div>
            <div class="d-flex justify-content-end gap-2 mt-3"><button class="btn btn-outline-secondary" @onclick="CloseForm" disabled="@busy">Cancel</button><button class="btn btn-primary" @onclick="SaveClientAsync" disabled="@busy">@(busy ? "Saving…" : editingClient is null ? "Create and reveal secret" : "Save client")</button></div>
        </section>
    }

    @if (rotating is not null)
    {
        <section class="panel mb-3" aria-labelledby="shared-variable-rotate-heading">
            <div class="section-heading"><div><h2 id="shared-variable-rotate-heading">Rotate @rotating.ClientId</h2><p>The current secret can remain valid briefly while callers deploy the replacement.</p></div><button type="button" class="btn-close" aria-label="Close rotation form" @onclick="CloseRotate"></button></div>
            @if (!string.IsNullOrWhiteSpace(formError))
            {
                <div class="alert alert-danger" role="alert">@formError@if (clientConflict) { <button class="btn btn-sm btn-outline-danger ms-2" @onclick="ReloadClientsAsync" disabled="@busy">Reload clients</button> }</div>
            }
            <div><label class="form-label" for="shared-client-grace">Old-secret grace period (hours)</label><input id="shared-client-grace" class="form-control" type="number" min="0" max="168" @bind="graceHours" /><div class="form-text">0 revokes the old secret immediately; 24 hours is the default; maximum is 168.</div></div>
            <div class="d-flex justify-content-end gap-2 mt-3"><button class="btn btn-outline-secondary" @onclick="CloseRotate" disabled="@busy">Cancel</button><button class="btn btn-primary" @onclick="RotateAsync" disabled="@busy">@(busy ? "Rotating…" : "Rotate and reveal secret")</button></div>
        </section>
    }

    <section class="panel panel-flush" aria-labelledby="shared-variable-client-results-heading">
        <div class="section-heading"><div><h2 id="shared-variable-client-results-heading">API clients</h2><p>@ResultSummary</p></div></div>
        @if (loading && result is null) { <div class="p-3"><div class="skeleton" role="status"></div></div> }
        else if (result is null) { <EmptyState Icon="alert" Title="API clients unavailable" Description="Use Refresh to retry. Authorization and API errors appear above." /> }
        else if (result.Items.Count == 0) { <EmptyState Icon="token" Title="No API clients" Description="Create a client to access shared variables with X-Client-Id and X-Client-Secret." /> }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead><tr><th>Client</th><th>Scopes</th><th>Status</th><th>Expiration</th><th>Revision</th><th><span class="visually-hidden">Actions</span></th></tr></thead>
                    <tbody>
                    @foreach (var client in result.Items)
                    {
                        <tr>
                            <td><span class="data-title">@client.DisplayName</span><span class="data-subtitle mono-id">@client.ClientId</span></td>
                            <td><div class="d-flex flex-wrap gap-1">@foreach (var scope in client.Scopes) { <StatusBadge Status="primary" Text="@ScopeLabel(scope)" /> }</div></td>
                            <td><StatusBadge Status="@(client.Status == "active" ? "success" : "neutral")" Text="@client.Status" /></td>
                            <td>@(client.ExpiresAt?.ToLocalTime().ToString("g") ?? "Never")</td>
                            <td>#@client.Revision<span class="data-subtitle">@client.UpdatedAt.ToLocalTime().ToString("g")</span></td>
                            <td class="text-end">
                                @if (client.Status == "active")
                                {
                                    <div class="d-flex justify-content-end gap-2"><button class="btn btn-sm btn-outline-secondary" @onclick="() => OpenEditAsync(client)" disabled="@busy">Edit</button><button class="btn btn-sm btn-outline-primary" @onclick="() => OpenRotate(client)" disabled="@busy">Rotate</button><button class="btn btn-sm btn-outline-danger" @onclick="() => RevokeAsync(client)" disabled="@busy">Revoke</button></div>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <div class="d-flex justify-content-between align-items-center p-3 border-top"><button class="btn btn-sm btn-outline-secondary" @onclick="PreviousPageAsync" disabled="@(busy || result.Page <= 1)">Previous</button><span class="data-subtitle">Page @result.Page of @TotalPages</span><button class="btn btn-sm btn-outline-secondary" @onclick="NextPageAsync" disabled="@(busy || result.Page >= TotalPages)">Next</button></div>
        }
    </section>
}

@code {
    private PagedResult<SharedVariableClientDto>? result;
    private SharedVariableClientDto? editingClient;
    private SharedVariableClientDto? rotating;
    private SharedVariableClientDto? secretClient;
    private string? oneTimeSecret;
    private string? error;
    private string? success;
    private string? formError;
    private string formClientId = string.Empty;
    private string formDisplayName = string.Empty;
    private DateTime? formExpires;
    private bool formRead = true;
    private bool formWrite;
    private bool formOpen;
    private bool loading;
    private bool busy;
    private bool clientConflict;
    private int graceHours = 24;
    private int page = 1;
    private const int PageSize = 25;
    private int TotalPages => result is null ? 1 : Math.Max(1, (int)Math.Ceiling(result.TotalCount / (double)result.PageSize));
    private string ResultSummary => result is null ? "Not loaded" : $"{result.TotalCount:N0} managed clients";

    protected override async Task OnInitializedAsync() { Token.Changed += OnTokenChanged; if (Token.HasToken) await LoadAsync(); }

    private async Task LoadAsync()
    {
        if (!Token.HasToken) { result = null; return; }
        try { loading = true; busy = true; error = null; result = await Api.GetSharedVariableClientsAsync(page, PageSize); }
        catch (WorkflowApiException ex) { result = null; error = FriendlyError(ex); }
        finally { loading = false; busy = false; }
    }

    private void OpenCreate() { rotating = null; editingClient = null; formOpen = true; formError = null; clientConflict = false; formClientId = formDisplayName = string.Empty; formExpires = null; formRead = true; formWrite = false; }
    private void CloseForm() { formOpen = false; editingClient = null; formError = null; clientConflict = false; }
    private void OpenRotate(SharedVariableClientDto client) { formOpen = false; editingClient = null; rotating = client; graceHours = 24; formError = null; clientConflict = false; }
    private void CloseRotate() { rotating = null; formError = null; clientConflict = false; }

    private void SetClientForm(SharedVariableClientDto client)
    {
        rotating = null; editingClient = client; formOpen = true; formError = null;
        clientConflict = false; formClientId = client.ClientId; formDisplayName = client.DisplayName;
        formRead = client.Scopes.Contains(SharedVariableClientScopes.Read, StringComparer.Ordinal);
        formWrite = client.Scopes.Contains(SharedVariableClientScopes.Write, StringComparer.Ordinal);
        formExpires = client.ExpiresAt?.LocalDateTime;
    }

    private async Task OpenEditAsync(SharedVariableClientDto client)
    {
        try
        {
            busy = true; error = null;
            var current = await Api.GetSharedVariableClientAsync(client.Id);
            if (current is null) { error = "The API client no longer exists."; await LoadAsync(); return; }
            SetClientForm(current);
        }
        catch (WorkflowApiException ex) { error = FriendlyError(ex); }
        finally { busy = false; }
    }

    private async Task ReloadClientEditAsync()
    {
        if (editingClient is null) return;
        await OpenEditAsync(editingClient);
    }

    private async Task SaveClientAsync()
    {
        if (editingClient is null) await CreateAsync();
        else await UpdateClientAsync();
    }

    private async Task CreateAsync()
    {
        formError = null;
        if (string.IsNullOrWhiteSpace(formClientId) || string.IsNullOrWhiteSpace(formDisplayName)) { formError = "Client ID and display name are required."; return; }
        var scopes = Scopes(); if (scopes.Count == 0) { formError = "Select at least one scope."; return; }
        if (!TryExpires(out var expires, out formError)) return;
        try
        {
            busy = true; error = success = null;
            var created = await Api.CreateSharedVariableClientAsync(new CreateSharedVariableClientRequest(formClientId.Trim(), formDisplayName.Trim(), scopes, expires));
            Reveal(created.Client, created.ClientSecret); CloseForm(); success = $"Created API client {created.Client.ClientId}. Save its secret now."; await LoadAsync();
        }
        catch (WorkflowApiException ex) { formError = FriendlyError(ex); }
        finally { busy = false; }
    }

    private async Task UpdateClientAsync()
    {
        if (editingClient is null) return;
        formError = null;
        if (string.IsNullOrWhiteSpace(formDisplayName)) { formError = "Display name is required."; return; }
        var scopes = Scopes(); if (scopes.Count == 0) { formError = "Select at least one scope."; return; }
        if (!TryExpires(out var expires, out formError)) return;
        try
        {
            busy = true; error = success = null;
            var updated = await Api.UpdateSharedVariableClientAsync(
                editingClient.Id,
                new UpdateSharedVariableClientRequest(
                    formDisplayName.Trim(), scopes, expires, editingClient.Revision));
            success = $"Updated API client {updated.ClientId} at revision {updated.Revision}.";
            CloseForm(); await LoadAsync();
        }
        catch (WorkflowApiException ex) { clientConflict = ex.StatusCode == HttpStatusCode.Conflict; formError = FriendlyError(ex); }
        finally { busy = false; }
    }

    private async Task RotateAsync()
    {
        if (rotating is null) return;
        if (graceHours is < 0 or > 168) { formError = "Grace period must be between 0 and 168 hours."; return; }
        try
        {
            busy = true; error = success = null;
            var rotated = await Api.RotateSharedVariableClientSecretAsync(rotating.Id, new RotateSharedVariableClientSecretRequest(rotating.Revision, graceHours));
            Reveal(rotated.Client, rotated.ClientSecret); CloseRotate(); success = $"Rotated {rotated.Client.ClientId}. Save the replacement secret now."; await LoadAsync();
        }
        catch (WorkflowApiException ex) { clientConflict = ex.StatusCode == HttpStatusCode.Conflict; formError = FriendlyError(ex); }
        finally { busy = false; }
    }

    private async Task RevokeAsync(SharedVariableClientDto client)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Immediately revoke {client.ClientId} and every active secret?")) return;
        try { busy = true; error = success = null; ClearSecret(); await Api.RevokeSharedVariableClientAsync(client.Id, new RevokeSharedVariableClientRequest(client.Revision, "Revoked from Flowbit.Ui")); success = $"Revoked {client.ClientId}."; await LoadAsync(); }
        catch (WorkflowApiException ex) { error = FriendlyError(ex); }
        finally { busy = false; }
    }

    private void Reveal(SharedVariableClientDto client, string secret) { secretClient = client; oneTimeSecret = secret; }
    private void ClearSecret() { secretClient = null; oneTimeSecret = null; }
    private async Task CopyCredentialsAsync() { if (secretClient is null || string.IsNullOrEmpty(oneTimeSecret)) return; await JS.InvokeVoidAsync("navigator.clipboard.writeText", $"X-Client-Id: {secretClient.ClientId}\nX-Client-Secret: {oneTimeSecret}"); success = "Copied the two authentication headers."; }
    private IReadOnlyList<string> Scopes() { var scopes = new List<string>(); if (formRead) scopes.Add(SharedVariableClientScopes.Read); if (formWrite) scopes.Add(SharedVariableClientScopes.Write); return scopes; }
    private bool TryExpires(out DateTimeOffset? expires, out string? message) { expires = formExpires is DateTime local ? new DateTimeOffset(DateTime.SpecifyKind(local, DateTimeKind.Local)) : null; message = null; if (expires <= DateTimeOffset.Now) { message = "Expiration must be in the future."; return false; } return true; }
    private async Task PreviousPageAsync() { if (page > 1) { page--; await LoadAsync(); } }
    private async Task NextPageAsync() { if (page < TotalPages) { page++; await LoadAsync(); } }
    private async Task ReloadClientsAsync() { CloseRotate(); await LoadAsync(); }
    private void OnTokenChanged() => _ = InvokeAsync(async () => { result = null; CloseForm(); CloseRotate(); ClearSecret(); error = success = null; page = 1; await LoadAsync(); });
    private static string ScopeLabel(string scope) => scope == SharedVariableClientScopes.Read ? "read" : scope == SharedVariableClientScopes.Write ? "write" : scope;
    private static string FriendlyError(WorkflowApiException ex) => ex.StatusCode switch { HttpStatusCode.Forbidden => "This identity does not have the configured shared-variable administrator role.", HttpStatusCode.Conflict => "The client changed or this identifier is already in use. Refresh and try again.", _ => ex.Message ?? "The client-management request failed." };
    public void Dispose() => Token.Changed -= OnTokenChanged;
}
