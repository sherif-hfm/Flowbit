@page "/change-password"
@inject WorkflowApiClient Api
@inject Flowbit.Ui.Auth.UiAuthenticationOptions Authentication
@inject Flowbit.Ui.Auth.IUiAccessTokenProvider Tokens
@inject NavigationManager Navigation

<PageTitle>Change Password · Flowbit</PageTitle>
<PageHeader Eyebrow="Account" Title="Change password" Description="Changing your password ends all of your local sessions." />
@if (error is not null) { <div class="alert alert-danger" role="alert">@error</div> }
@if (Authentication.IsLocal)
{
    <section class="panel" style="max-width:36rem"><form @onsubmit="Save" @onsubmit:preventDefault>
        <label class="form-label" for="current-password">Current password</label><input id="current-password" class="form-control mb-3" type="password" @bind="current" required maxlength="128" autocomplete="current-password" />
        <label class="form-label" for="new-password">New password</label><input id="new-password" class="form-control mb-3" type="password" @bind="password" required maxlength="128" autocomplete="new-password" />
        <label class="form-label" for="confirm-password">Confirm new password</label><input id="confirm-password" class="form-control mb-4" type="password" @bind="confirm" required maxlength="128" autocomplete="new-password" />
        <button class="btn btn-primary" type="submit" disabled="@busy">Change password</button>
    </form></section>
}
else { <p>Password management is handled by your identity provider.</p> }

@code {
    private string current = "", password = "", confirm = "";
    private string? error;
    private bool busy;
    private async Task Save()
    {
        error = null;
        if (password != confirm) { error = "The new passwords do not match."; return; }
        busy = true;
        try { await Api.ChangeLocalPasswordAsync(new(current, password)); Tokens.RejectSession(); Navigation.NavigateTo("/auth/signed-out", forceLoad: true); }
        catch (Exception e) { error = e.Message; }
        finally { current = password = confirm = ""; busy = false; }
    }
}
