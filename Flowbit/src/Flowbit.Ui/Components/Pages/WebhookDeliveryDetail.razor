@page "/webhooks/deliveries/{Id:guid}"
@implements IDisposable
@using Flowbit.Ui.Auth
@inject WorkflowApiClient Api
@inject TokenState Token
@inject IJSRuntime JS

<PageTitle>Webhook Delivery · Flowbit</PageTitle>

<PageHeader Eyebrow="Webhooks" Title="Webhook delivery"
            Description="One lifecycle event for one subscription: the exact signed body, its captured destination, and every attempt.">
    <Actions>
        <a class="btn btn-outline-primary" href="webhooks">All webhooks</a>
        <button class="btn btn-primary" @onclick="RefreshAsync" disabled="@(!Token.HasToken || busy)"><AppIcon Name="refresh" /> Refresh</button>
    </Actions>
</PageHeader>

@if (!string.IsNullOrWhiteSpace(error)) { <div class="alert alert-danger" role="alert">@error</div> }
@if (!string.IsNullOrWhiteSpace(success)) { <div class="alert alert-success" role="status">@success</div> }

@if (!Token.HasToken)
{
    <section class="panel"><EmptyState Icon="token" Title="An administrative identity is required" Description="Webhook deliveries are visible to the settings administrator role only."><IdentityAction Class="btn btn-primary" DevelopmentLabel="Set test identity" /></EmptyState></section>
}
else if (loading && detail is null)
{
    <section class="panel"><div class="skeleton" role="status" aria-label="Loading delivery"></div></section>
}
else if (notFound)
{
    <section class="panel"><EmptyState Icon="alert" Title="Delivery not found" Description="It may have been removed by retention after it settled." /></section>
}
else if (detail is not null)
{
    var delivery = detail.Delivery;
    <section class="panel mb-3" aria-labelledby="delivery-summary-heading">
        <div class="section-heading">
            <div>
                <h2 id="delivery-summary-heading">@WebhookFormatting.EventTypeLabel(delivery.EventType) to @delivery.SubscriptionName</h2>
                <p><StatusBadge Status="@WebhookFormatting.DeliveryStateTone(delivery.State)" Text="@WebhookFormatting.DeliveryStateLabel(delivery.State)" /> Subscription is @detail.SubscriptionState.</p>
            </div>
            <div class="d-flex gap-2">
                @if (detail.CanRetry) { <button class="btn btn-sm btn-outline-primary" @onclick="RetryAsync" disabled="@busy">Retry</button> }
                @if (detail.CanDiscard) { <button class="btn btn-sm btn-outline-danger" @onclick="DiscardAsync" disabled="@busy">Discard</button> }
            </div>
        </div>
        <div class="summary-grid">
            <div class="summary-item"><span>Event ID (webhook-id)</span><strong class="mono-id">@delivery.EventId.ToString("D")</strong></div>
            <div class="summary-item"><span>Occurred</span><strong><LocalTime Value="@delivery.OccurredAt" /></strong></div>
            <div class="summary-item"><span>Attempt budget</span><strong>@WebhookFormatting.Budget(delivery)</strong></div>
            <div class="summary-item"><span>Retry window ends</span><strong><LocalTime Value="@detail.DeadlineAt" EmptyText="Starts with the next send" /></strong></div>
            <div class="summary-item"><span>Last result</span><strong>@WebhookFormatting.OutcomeWithStatus(delivery.LastOutcome, delivery.LastHttpStatus)</strong></div>
            <div class="summary-item"><span>Failure</span><strong class="mono-id">@(delivery.FailureCode ?? "None")</strong></div>
            <div class="summary-item"><span>Next attempt</span><strong><LocalTime Value="@delivery.DueAt" EmptyText="—" /></strong></div>
            <div class="summary-item"><span>Instance</span><strong>@if (delivery.InstanceId is { } instance) { <a href="@($"instances/{instance}")">#@instance</a> } else { <text>None</text> }</strong></div>
        </div>
        <div class="mt-3">
            <span class="form-label d-block">Captured destination (revision @delivery.ConfigurationRevision)</span>
            <code class="d-block text-break">@detail.EndpointUrl</code>
            <div class="form-text">Retries always use this destination, even after the subscription's URL changes. Requests are signed with the subscription's current keys.</div>
        </div>
    </section>

    <section class="panel mb-3" aria-labelledby="delivery-body-heading">
        <div class="section-heading"><div><h2 id="delivery-body-heading">External event body</h2><p>Indented for reading, with every character as stored. Receivers verify the exact signed body below, which Flowbit sends unchanged on every attempt.</p></div></div>
        <pre class="mb-0"><code>@WebhookFormatting.PrettyBody(detail.Body)</code></pre>
        <details class="mt-3">
            <summary class="section-link">Exact signed body</summary>
            <pre class="mt-2 mb-0" style="white-space: pre-wrap; overflow-wrap: anywhere;"><code>@detail.Body</code></pre>
        </details>
    </section>

    <section class="panel panel-flush" aria-labelledby="delivery-attempts-heading">
        <div class="section-heading"><div><h2 id="delivery-attempts-heading">Attempts</h2><p>@(attempts is null ? "Not loaded" : $"{attempts.TotalCount:N0} attempts by number. Response bodies are never stored.")</p></div></div>
        @if (attempts is null || attempts.Items.Count == 0)
        {
            <EmptyState Icon="clock" Title="No attempts yet" Description="The Worker records an attempt each time it acquires this delivery." />
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead><tr><th>#</th><th>Generation</th><th>Started</th><th>Outcome</th><th>Duration</th><th>Signing keys</th></tr></thead>
                    <tbody>
                    @foreach (var attempt in attempts.Items)
                    {
                        <tr>
                            <td>@attempt.AttemptNumber</td>
                            <td>@attempt.RetryGeneration</td>
                            <td><LocalTime Value="@(attempt.SendIntentAt ?? attempt.AcquiredAt)" />@if (attempt.SendIntentAt is null) { <span class="data-subtitle">Not sent</span> }</td>
                            <td>@(attempt.Outcome is null ? "In progress" : WebhookFormatting.OutcomeWithStatus(attempt.Outcome, attempt.HttpStatus))</td>
                            <td>@(attempt.DurationMilliseconds is { } duration ? $"{duration:N0} ms" : "—")</td>
                            <td class="mono-id">@(attempt.SigningKeyIds.Count == 0 ? "—" : string.Join(", ", attempt.SigningKeyIds.Select(key => key.ToString("D")[..8])))</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <div class="pagination-bar"><span class="pagination-copy">Page @attempts.Page of @AttemptPages</span><div class="d-flex gap-2"><button class="btn btn-sm btn-outline-secondary" @onclick="() => ChangeAttemptPageAsync(-1)" disabled="@(busy || attempts.Page <= 1)">Previous</button><button class="btn btn-sm btn-outline-secondary" @onclick="() => ChangeAttemptPageAsync(1)" disabled="@(busy || attempts.Page >= AttemptPages)">Next</button></div></div>
        }
    </section>
}
else if (!permissionDenied)
{
    @* A load that failed for another reason says so; after a 401 or 403 only the permission message above remains. *@
    <section class="panel"><EmptyState Icon="alert" Title="Delivery unavailable" Description="Use Refresh to retry. The error appears above." /></section>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private WebhookDeliveryDetailDto? detail;
    private PagedResult<WebhookDeliveryAttemptDto>? attempts;
    private string? error;
    private string? success;
    private bool loading;
    // Guards every request: a second click while one runs does nothing.
    private bool busy;
    private bool notFound;
    // Set by a 401 or 403, which leaves only the permission message.
    private bool permissionDenied;
    private bool disposed;
    // The delivery this page shows; a different route id loads afresh, even after a not-found.
    private Guid? loadedId;
    private int attemptPage = 1;
    // Bumped when the identity or the delivery changes, or the page is disposed; replies to earlier requests are
    // then ignored.
    private int version;

    private int AttemptPages => attempts is null ? 1 : Math.Max(1, (int)Math.Ceiling(attempts.TotalCount / (double)attempts.PageSize));

    protected override void OnInitialized() => Token.Changed += OnTokenChanged;

    protected override async Task OnParametersSetAsync()
    {
        if (loadedId == Id) return;
        loadedId = Id;
        version++;
        Reset();
        if (Token.HasToken) await RefreshAsync();
    }

    // Reloads the delivery. The previous message stays until the reload replaces it.
    private async Task RefreshAsync()
    {
        if (!Token.HasToken) { Reset(); return; }
        if (busy) return;
        var current = version;
        busy = true;
        try
        {
            var loadError = await LoadAsync(current);
            if (current != version) return;
            error = loadError; success = null;
        }
        finally { if (current == version) busy = false; }
    }

    // Loads the delivery and its attempts and returns the failure to report, or null once both loaded.
    private async Task<string?> LoadAsync(int current)
    {
        loading = true;
        try
        {
            var loaded = await Api.GetWebhookDeliveryAsync(Id);
            if (current != version) return null;
            permissionDenied = false;
            detail = loaded;
            notFound = loaded is null;
            if (loaded is null) { attempts = null; return null; }
            var loadedAttempts = await Api.GetWebhookDeliveryAttemptsAsync(Id, attemptPage, 25);
            if (current != version) return null;
            attempts = loadedAttempts;
            return null;
        }
        catch (Exception ex)
        {
            if (current != version) return null;
            var message = WebhookFormatting.ErrorMessage(ex);
            if (WebhookFormatting.IsPermissionFailure(ex)) Deny(message);
            return message;
        }
        finally { if (current == version) loading = false; }
    }

    private void Deny(string message)
    {
        permissionDenied = true; notFound = false; detail = null; attempts = null;
        error = message; success = null;
    }

    private async Task ChangeAttemptPageAsync(int delta)
    {
        if (busy) return;
        attemptPage = Math.Max(1, (attempts?.Page ?? attemptPage) + delta);
        await RefreshAsync();
    }

    private Task RetryAsync() => RunAsync(async shown =>
    {
        var result = await Api.RetryWebhookDeliveryAsync(shown.Delivery.Id, shown.Delivery.Revision);
        return $"Queued retry generation {result.RetryGeneration} with the original event and destination.";
    });

    private Task DiscardAsync() => RunAsync(async shown =>
    {
        await Api.DiscardWebhookDeliveryAsync(shown.Delivery.Id, shown.Delivery.Revision);
        return "Discarded the delivery.";
    }, "Discard this delivery? It will never be sent.");

    // Runs one action on the shown delivery, then reloads it so the result is reported against the current state.
    // The action's own message survives that reload; a refused (409) request is reported and never replayed.
    private async Task RunAsync(Func<WebhookDeliveryDetailDto, Task<string>> action, string? confirmation = null)
    {
        if (busy || detail is not { } shown) return;
        var current = version;
        busy = true;
        try
        {
            if (confirmation is not null && !await ConfirmAsync(confirmation, current)) return;
            error = success = null;
            string? done = null;
            Exception? failure = null;
            try { done = await action(shown); }
            catch (Exception ex)
            {
                if (current != version) return;
                if (WebhookFormatting.IsPermissionFailure(ex)) { Deny(WebhookFormatting.ErrorMessage(ex)); return; }
                failure = ex;
            }
            if (current != version) return;
            var loadError = await LoadAsync(current);
            if (current != version || permissionDenied) return;
            success = done;
            error = WebhookFormatting.WithReloadFailure(failure is null ? null : WebhookFormatting.ActionFailure(failure, loadError is null), loadError);
        }
        finally { if (current == version) busy = false; }
    }

    // The browser's confirmation dialog; one it cannot show cancels the action.
    private async Task<bool> ConfirmAsync(string message, int current)
    {
        try { return await JS.InvokeAsync<bool>("confirm", message) && current == version; }
        catch (Exception ex)
        {
            if (current == version) error = ex.Message;
            return false;
        }
    }

    private void Reset()
    {
        detail = null; attempts = null; error = success = null;
        loading = busy = notFound = permissionDenied = false;
        attemptPage = 1;
    }

    private void OnTokenChanged() => _ = InvokeAsync(async () =>
    {
        if (disposed) return;
        version++;
        Reset();
        StateHasChanged();
        await RefreshAsync();
        if (!disposed) StateHasChanged();
    });

    public void Dispose()
    {
        disposed = true;
        version++;
        Token.Changed -= OnTokenChanged;
    }
}
