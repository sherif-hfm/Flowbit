@inherits LayoutComponentBase
@implements IDisposable
@using Flowbit.Ui.Auth
@inject TokenState Token
@inject NavigationManager Navigation

<a class="skip-link" href="#main-content">Skip to main content</a>

<div class="app-shell @(IsEditorRoute ? "editor-layout" : null)" data-interactive="@(RendererInfo.IsInteractive ? "true" : "false")">
    <aside id="primary-navigation" class="sidebar @(mobileNavOpen ? "is-open" : null)" aria-label="Primary navigation">
        <a class="brand" href="" @onclick="CloseNavigation">
            <img class="brand-mark" src="@Assets["branding/flowbit-mark.svg"]" width="40" height="40" alt="" />
            <span>
                <strong>Flowbit</strong>
                <small>Workflow operations</small>
            </span>
        </a>

        <NavMenu OnNavigate="CloseNavigation" />

        <div class="sidebar-footer">
            <div class="sidebar-identity">
                <span class="avatar">@IdentityInitial</span>
                <span class="identity-copy">
                    <strong>@IdentityName</strong>
                    <small>@IdentityRoleSummary</small>
                </span>
            </div>
            <IdentityAction Class="btn btn-outline-secondary btn-sm" DevelopmentLabel="Test identity" />
        </div>
    </aside>

    @if (mobileNavOpen)
    {
        <button class="sidebar-scrim" type="button" aria-label="Close navigation" @onclick="CloseNavigation"></button>
    }

    <div class="workspace">
        <header class="topbar">
            <div class="topbar-leading">
                <button class="mobile-menu" type="button" aria-label="Open navigation"
                        aria-controls="primary-navigation" aria-expanded="@(mobileNavOpen ? "true" : "false")"
                        @onclick="ToggleNavigation">
                    <span></span><span></span><span></span>
                </button>
                <a class="mobile-brand" href="" aria-label="Flowbit home" @onclick="CloseNavigation">
                    <img src="@Assets["branding/flowbit-mark.svg"]" width="32" height="32" alt="" />
                    <span>Flowbit</span>
                </a>
                <div>
                    <strong>Operations workspace</strong>
                    <small>Design, run, and manage business workflows</small>
                </div>
            </div>

            <div class="topbar-actions">
                <a class="btn btn-primary btn-sm topbar-start" href="workflows">
                    <AppIcon Name="plus" />
                    Start workflow
                </a>
                <div class="topbar-profile" aria-label="Current identity">
                    <span class="avatar">@IdentityInitial</span>
                    <span>
                        <strong>@IdentityName</strong>
                        <small>@(Token.IsDevelopment ? "Test identity" : Token.HasToken ? "Signed in" : "Signed out")</small>
                    </span>
                </div>
                @if (!Token.IsDevelopment)
                {
                    <IdentityAction Class="btn btn-outline-primary btn-sm" />
                }
            </div>
        </header>

        <main id="main-content" tabindex="-1">
            <article class="content-shell">
                @Body
            </article>
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool mobileNavOpen;
    private bool IsEditorRoute
    {
        get
        {
            var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/');
            return path == "workflows/new" || System.Text.RegularExpressions.Regex.IsMatch(path, @"^workflows/\d+/edit$");
        }
    }

    private string IdentityName => Token.HasToken ? Token.CurrentUser ?? "Anonymous" : "No identity";
    private string IdentityInitial => IdentityName[..1].ToUpperInvariant();
    private string IdentityRoleSummary => Token.HasToken
        ? Token.CurrentRoles.Count == 0 ? "No roles" : string.Join(", ", Token.CurrentRoles.Take(2))
        : Token.IsDevelopment ? "Configure test token" : "Sign in to continue";

    protected override void OnInitialized()
    {
        Token.Changed += OnTokenChanged;
        Navigation.LocationChanged += OnLocationChanged;
    }
    private void OnLocationChanged(object? sender, LocationChangedEventArgs args) => _ = InvokeAsync(StateHasChanged);

    private void ToggleNavigation() => mobileNavOpen = !mobileNavOpen;
    private void CloseNavigation() => mobileNavOpen = false;
    private void OnTokenChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Token.Changed -= OnTokenChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
