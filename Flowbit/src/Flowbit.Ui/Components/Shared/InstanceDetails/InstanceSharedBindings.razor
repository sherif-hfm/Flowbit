@if (Bindings.Count > 0)
{
    <section id="shared-variables" class="panel mb-3">
        <div class="section-heading">
            <div><h2>Shared-variable bindings</h2><p>Value-free catalog metadata snapshotted for this workflow version. Current deployment-wide values are managed separately.</p></div>
            <a class="section-link" href="shared-variables">Manage catalog <AppIcon Name="chevron-right" /></a>
        </div>
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <caption class="visually-hidden">Shared-variable bindings for instance #@InstanceId</caption>
                <thead><tr><th scope="col">Alias</th><th scope="col">Catalog key</th><th scope="col">Contract</th><th scope="col">Access</th><th scope="col">Catalog state</th><th scope="col">Updated</th></tr></thead>
                <tbody>
                @foreach (var binding in Bindings)
                {
                    <tr>
                        <td><strong>@binding.Alias</strong></td>
                        <td><code>@binding.Key</code></td>
                        <td><code>@binding.DataType@(binding.IsArray ? "[]" : null)</code>@(binding.Nullable ? " · nullable" : null)<span class="data-subtitle">@(string.IsNullOrWhiteSpace(binding.Validation) ? "No validation" : binding.Validation)</span></td>
                        <td>@(binding.Access == "readWrite" ? "Read / write" : "Read only")</td>
                        <td><StatusBadge Status="@(binding.Status == "active" ? "success" : "neutral")" Text="@binding.Status" /><span class="data-subtitle">Revision #@binding.Revision · @(binding.HasValue ? "Value set" : "Value unset")</span></td>
                        <td>@binding.UpdatedAt.ToLocalTime().ToString("g")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
}

@code {
    [Parameter]
    public long InstanceId { get; set; }

    [Parameter]
    public IReadOnlyList<SharedVariableBindingMetadataDto> Bindings { get; set; } = [];
}
