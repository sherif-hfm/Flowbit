@using static Flowbit.Ui.Components.Shared.Signals.SignalFormatting
@if (Deliveries is null)
{
    <div class="p-3"><div class="skeleton" role="status"></div></div>
}
else if (Deliveries.Count == 0)
{
    <div class="px-3 pb-3"><EmptyState Icon="jobs" Title="No deliveries" Description="No delivery matches the selected status and kind." /></div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead><tr><th>Delivery</th><th>Instance</th><th>Event</th><th>Status</th><th>Result</th><th>Updated</th></tr></thead>
            <tbody>
                @foreach (var delivery in Deliveries)
                {
                    var isStart = delivery.Kind == SignalDeliveryKinds.Start;
                    <tr>
                        <td>#@delivery.Id<span class="data-subtitle">Attempts: @delivery.AttemptCount</span></td>
                        <td>@if (delivery.InstanceId is long instanceId)
                            {<a href="@($"instances/{instanceId}")">Instance #@instanceId</a>}
                            else
                            {<span class="text-muted">No instance</span>}<span class="data-subtitle">@delivery.WorkflowKey</span></td>
                        <td>Node #@delivery.SignalNodeId<span class="data-subtitle">@(isStart ? "Start" : delivery.AttachedToNodeId is null ? "Catch" : $"Boundary on node #{delivery.AttachedToNodeId}")</span></td>
                        <td><StatusBadge Status="@delivery.Status" Text="@DeliveryStatusLabel(delivery.Status)" /></td>
                        <td>@ResultLabel(delivery.ResultCode, delivery.Kind)@if (!string.IsNullOrWhiteSpace(delivery.ResultDescription))
                            {
                                <span class="data-subtitle signal-result-description">@delivery.ResultDescription</span>
                            }</td>
                        <td><LocalTime Value="@delivery.UpdatedAt" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter] public IReadOnlyList<SignalDeliveryDto>? Deliveries { get; set; }
}
