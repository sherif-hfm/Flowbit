{
  "WorkflowApi": {
    "BaseUrl": "http://localhost:5017"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/flowbit-ui-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Session": {
      "RevalidationInterval": "00:01:00",
      "AbsoluteLifetime": "08:00:00"
    },
    "Oidc": {
      "AllowHttpMetadata": false,
      "UsePkce": true,
      "Scopes": [
        "openid",
        "profile",
        "offline_access",
        "flowbit.api"
      ],
      "ClientId": "",
      "Authority": ""
    },
    "Mode": "OpenIdConnect"
  }
}
